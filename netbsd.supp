{
   NetBSD-__vfprintf_unlocked_l
   Memcheck:Cond
   fun:__vfprintf_unlocked_l
}


# NetBSD ld.elf_so uses its own implementation of mutex based on
# memory barriers and atomic ops, which results in false negatives
# detected by Helgrind.
{
   NetBSD-rtld-mutex
   Helgrind:Race
   fun:_rtld_exclusive_exit
}

# Ditto for mutex primitives in libpthread
{
   NetBSD-libpthread-mutex-lock
   Helgrind:Race
   fun:__libc_mutex_*lock
}

# Ditto for libpthread's internal locks
{
   NetBSD-libpthread-alltree-lock
   Helgrind:Race
   fun:pthread__find
}

# should be in separate file
{
   NetBSD-pthread_join
   Helgrind:Race
   fun:pthread_join
}

{
   NetBSD-pthread_exit
   Helgrind:Race
   ...
   fun:pthread_exit
}

{
   NetBSD-pthread_barrier_wait
   Helgrind:Race
   fun:pthread_barrier_wait
}

{
   NetBSD-pthread__park
   Helgrind:Race
   fun:pthread__park
}

{
   NetBSD-pthread_once
   Helgrind:Race
   fun:pthread_once
}

{
   NetBSD-je_arena_dalloc_small
   Helgrind:Race
   fun:je_arena_dalloc_small
}

{
   NetBSD-_rtld_shared_enter
   Helgrind:Race
   fun:_rtld_shared_enter
}

{
   NetBSD-pthread_barrier_init
   Helgrind:Race
   fun:pthread_barrier_init
}

{
   NetBSD-pthread_barrier_destroy
   Helgrind:Race
   fun:pthread_barrier_destroy
}

{
   NetBSD-_rtld_exit
   Helgrind:Race
   ...
   fun:_rtld_exit
}

{
   NetBSD-pthread__create_tramp
   Helgrind:Race
   fun:mythread_wrapper
   fun:pthread__create_tramp
}

{
   NetBSD-dlopen
   drd:ConflictingAccess
   fun:dlopen
}

{
   NetBSD-_rtld_bind
   drd:ConflictingAccess
   ...
   fun:_rtld_bind
}

{
   NetBSD-getaddrinfo
   drd:ConflictingAccess
   ...
   fun:getaddrinfo
}

{
   NetBSD-pthread_create
   drd:ConflictingAccess
   ...
   fun:pthread_create
}

